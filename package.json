  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node scripts/preflight.mjs && npm run build && node --disable-warning=ExperimentalWarning server/main.ts",
    "server": "node --disable-warning=ExperimentalWarning server/main.ts",
